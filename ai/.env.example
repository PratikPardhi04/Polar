# Copy to ai/.env and fill in. NEVER commit the real file.
# Backend the agents read through (tools call REST, never the DB directly).
BACKEND_URL=http://localhost:8000
# Groq key for openai/gpt-oss-120b (all six agents share one model factory).
# Get one free at https://console.groq.com/keys — without it, only the
# deterministic POST /ai/ask path works; POST /ai/ask-llm returns 503.
GROQ_API_KEY=
# Model override for hosted demos (fast + fits serverless timeouts):
#   AI_MODEL=llama-3.1-8b-instant
AI_MODEL=openai/gpt-oss-120b
# Service bearer token the agents use against the backend (RBAC still applies).
# Mint via POST /auth/register + /auth/login for a dedicated account.
AI_SERVICE_TOKEN=
# Browser origins allowed to call the AI service (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
