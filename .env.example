# =====================================================================
# POLARIS environment template — copy to .env and fill in.
#   Copy-Item .env.example .env   (then edit; NEVER commit .env)
# Local SQLite rehearsal needs only DATABASE_URL. Everything else has
# safe demo defaults, except JWT_SECRET_KEY which you MUST replace for
# any shared/deploy preview (generate: python -c "import secrets;
# print(secrets.token_hex(32))").
# =====================================================================

# ---- Backend (FastAPI :8000) ---------------------------------------
APP_NAME=POLARIS
APP_ENV=demo

# Local rehearsal (no Docker):
#   DATABASE_URL=sqlite:///./polaris_demo.db   (relative to server CWD —
#   prefer the absolute form below so every terminal uses the same file)
# Local Postgres / production (Neon, Supabase, Vercel Postgres):
#   DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:5432/polaris
DATABASE_URL=sqlite:///C:/Users/prati/Desktop/Lets Build It/POLAR/polar-expedition-system/polaris_demo.db

# Auth — REPLACE the default before any shared deploy
JWT_SECRET_KEY=change-me-exp-46isea-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Browser origins allowed to call the API (comma-separated).
# Local: http://localhost:5173,http://127.0.0.1:5173
# Vercel: https://<your-frontend>.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Check-in worker trigger for serverless hosts (Vercel Cron hits
# POST /api/v1/check-ins/advance-cron?cron_secret=...). Leave empty locally
# (the in-process scheduler runs instead). Generate like JWT_SECRET_KEY.
CRON_SECRET=

# Read by GET /api/v1/dashboard/summary; flipped by Simulate Network Outage.
NETWORK_STATUS=ONLINE
